{
	"compilerOptions": {
		"importHelpers": true,
		"moduleResolution": "node",
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"sourceMap": true,
		"baseUrl": ".",
		"lib": ["es2015", "dom"], // Add this line
		"paths": {
			"@jd_template/*": ["src/scripts/*"]
		},
		"resolveJsonModule": true,
		"module": "CommonJS"
	},
	"include": ["src/scripts/**/*.ts", "src/scripts/**/*.vue"],
	"exclude": ["node_modules"]
}
