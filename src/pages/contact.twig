{% extends 'views/layouts/main.twig' %}

{% block page %}
	{% set ce = {
		form: {
			fields: [
				{
					placeholder: 'Vaše meno',
					type: 'text',
					required: true
				},
				{
					placeholder: 'Váš email',
					type: 'email',
					required: true
				},
				{
					placeholder: 'Vaša správa',
					type: 'textarea',
					required: true
				}
			],
			gdpr: 'Cookies',
			submit: 'Odoslať'
		}
	} %}

	<section class="py-16">
		<div class="container">
			<div class="mx-auto max-w-xl">
				<form action="" class="flex flex-col gap-4">
					<div class="contact__fields-wrapper flex flex-col gap-4">
						{% for index, item in ce.form.fields %}
							{% include 'views/components/utils/forms/_input.twig' with {
								item: item,
								index: index
							} only %}
						{% endfor %}
					</div>

					<div class="flex flex-wrap items-center justify-between gap-4">
						{% include 'views/components/utils/forms/_checkbox.twig' with {
							id: 'gdpr',
							label: ce.form.gdpr
						} %}

						<button
							type="submit"
							class="btn inline-flex items-center justify-center rounded bg-neutral-900 px-4 py-2 text-white transit hover:bg-neutral-700"
						>
							{{ ce.form.submit }}
						</button>
					</div>
				</form>
			</div>
		</div>
	</section>
{% endblock %}
