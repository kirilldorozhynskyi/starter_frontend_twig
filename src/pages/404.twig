{% extends 'views/layouts/main.twig' %}

{% block page %}
	<section class="content404 flex min-h-dvh items-center">
		<div class="container">
			<div class="max-w-xl">
				<h1 class="content404__title text-7xl font-bold lg:text-9xl">404</h1>
				<h3 class="mt-2 text-xl text-neutral-600">Sorry, this page does not appear to exist.</h3>

				<div class="mt-6">
					{% include 'views/components/utils/_button.twig' with {
						button: {
							class: 'bg-neutral-900 text-white',
							btn: {
								title: 'Home',
								url: '/'
							}
						}
					} only %}
				</div>
			</div>
		</div>
	</section>
{% endblock %}
