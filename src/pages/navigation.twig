{% extends 'views/layouts/main.twig' %}

{% block page %}
	<section class="py-16">
		<div class="container">
			<h1 class="mb-6 text-2xl font-bold">Pages</h1>
			<nav class="flex flex-col gap-2">
				{% for item in navigation %}
					<a class="text-neutral-700 underline-offset-2 hover:underline" href="{{ item }}">{{ item }}</a>
				{% endfor %}
			</nav>
		</div>
	</section>
{% endblock %}
