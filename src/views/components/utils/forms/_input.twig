{% set fieldId = item.type ~ index %}

<div class="form-field {{ item.error ? 'is-invalid' }} {{ item.class }}">
	{% if item.label and item.type != 'checkbox' %}
		<label class="mb-1 block text-sm font-medium" for="{{ fieldId }}">{{ item.label }}</label>
	{% endif %}

	{% if item.text %}
		<p class="mb-2 text-sm text-neutral-500">
			{{ item.text }}
		</p>
	{% endif %}

	{% if item.type == 'textarea' %}
		<textarea
			class="block w-full rounded border border-neutral-300 px-3 py-2 outline-none focus:border-neutral-900"
			name="{{ item.name ?? fieldId }}"
			id="{{ fieldId }}"
			rows="4"
			placeholder="{{ item.placeholder }}"
			{{ item.required ? 'required' }}
		>
			{{ item.value }}
		</textarea>
	{% elseif item.type == 'checkbox' %}
		{% include '_checkbox.twig' with {
			label: item.label,
			id: index
		} only %}
	{% elseif item.type == 'select' %}
		<select
			class="block w-full rounded border border-neutral-300 px-3 py-2 outline-none focus:border-neutral-900"
			name="{{ item.name ?? fieldId }}"
			id="{{ fieldId }}"
			aria-label="{{ item.placeholder }}"
		>
			{% if item.placeholder %}
				<option value="" disabled selected>
					{{ item.placeholder }}
				</option>
			{% endif %}
			{% for option in item.options %}
				<option value="{{ option.value }}">
					{{ option.title }}
				</option>
			{% endfor %}
		</select>
	{% else %}
		<input
			type="{{ item.type }}"
			class="block w-full rounded border border-neutral-300 px-3 py-2 outline-none focus:border-neutral-900"
			name="{{ item.name ?? fieldId }}"
			id="{{ fieldId }}"
			value="{{ item.value }}"
			placeholder="{{ item.placeholder }}"
			{{ item.required ? 'required' }}
		/>
	{% endif %}

	{% if item.help %}
		<small class="mt-1 block text-xs text-neutral-500">{{ item.help }}</small>
	{% endif %}

	{% if item.error %}
		<p class="mt-1 text-sm text-red-600">
			{{ item.error }}
		</p>
	{% endif %}
</div>
