{% set baseClass = 'btn inline-flex items-center justify-center gap-2 rounded px-4 py-2 transit' %}
{% set finalClass = baseClass ~ (button.class ? ' ' ~ button.class) ~ (button.icon ? ' btn-icon') %}

{% if button.span %}
	<button type="button" class="{{ finalClass }}">
		{{ button.btn.title }}
		{% if button.icon %}
			{{ sprite(button.icon) }}
		{% endif %}
	</button>
{% else %}
	<a
		href="{{ button.btn.url }}"
		title="{{ button.btn.title }}"
		{{ button.btn.target ? 'target="' ~ button.btn.target ~ '" rel="noopener noreferrer"' }}
		class="{{ finalClass }}"
	>
		{{ button.btn.title }}
		{% if button.icon %}
			{{ sprite(button.icon) }}
		{% endif %}
	</a>
{% endif %}
