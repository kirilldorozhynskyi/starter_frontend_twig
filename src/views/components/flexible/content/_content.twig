<section class="content py-16">
	<div class="container">
		<div class="prose max-w-none">
			{% if ce.title %}
				<h1 class="text-balance">{{ ce.title }}</h1>
			{% endif %}

			{% if ce.text %}
				<p class="text-pretty">
					{{ ce.text }}
				</p>
			{% endif %}
		</div>
	</div>
</section>
