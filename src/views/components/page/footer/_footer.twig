<footer class="footer mt-20 bg-neutral-100 py-12">
	<div class="container py-12">
		<div class="grid gap-8 lg:grid-cols-12 lg:items-start">
			<div class="lg:col-span-2">
				<a class="inline-flex" href="/" aria-label="{{ site_title }}">
					{% if logoRaw %}
						{{ source(rootDir ~ '/public/assets/images/brand/logo.svg')|raw }}
					{% else %}
						{{ svg(logo) }}
					{% endif %}
				</a>
			</div>

			{% if footer.copyright %}
				<div class="text-sm text-neutral-500 lg:col-span-5 lg:col-start-4">
					{{ '© ' ~ ('now'|date('Y')) ~ ' ' ~ footer.copyright }}
				</div>
			{% endif %}

			<div class="flex flex-col gap-4 lg:col-span-4">
				{% if footer_menu %}
					<ul class="flex flex-col gap-2 text-neutral-500">
						{% for item in footer_menu %}
							<li><a class="hover:text-neutral-900" href="{{ item.url }}" title="{{ item.title }}">{{ item.title }}</a></li>
						{% endfor %}
					</ul>
				{% endif %}

				{% if social %}
					<div class="flex gap-2">
						{% for item in social %}
							<a class="text-2xl leading-none" href="{{ item.url }}" aria-label="{{ item.title }}" target="_blank" rel="noopener noreferrer">
								{{ sprite(item.icon) }}
							</a>
						{% endfor %}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</footer>
