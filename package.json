{
	"title": "Vite front-end twig boilerplate",
	"name": "starter_frontend_twig",
	"version": "3.1.0",
	"type": "module",
	"private": true,
	"keywords": [
		"boilerplate",
		"startkit",
		"template",
		"library",
		"front end",
		"css",
		"documentation",
		"sass",
		"twig",
		"vite",
		"vituum",
		"sassdoc",
		"grid",
		"layout",
		"framework",
		"frameworks"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"webp": "node scripts/webp.js",
		"i18n:add": "vue-i18n-extract report --vueFiles './src/scripts/**/**/**/*.?(js|vue)' --languageFiles './src/scripts/util/lang/*.?(json|yml|yaml|js|ts)' --add",
		"i18n:remove": "vue-i18n-extract remove --vueFiles './src/scripts/**/*.?(js|vue)' --languageFiles './src/scripts/util/lang/*.?(json|yml|yaml|js|ts)' --remove"
	},
	"devDependencies": {
		"@spiriit/vite-plugin-svg-spritemap": "^5.0.0",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vituum/vite-plugin-twig": "^1.1.0",
		"@vue/runtime-core": "^3.5.21",
		"@vue/tsconfig": "^0.8.1",
		"@vueuse/core": "^13.9.0",
		"@zackad/prettier-plugin-twig": "^0.16.0",
		"html-minifier-terser": "^7.2.0",
		"imagemin": "^9.0.1",
		"imagemin-webp": "^8.0.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"typescript": "^5.9.2",
		"vanilla-lazyload": "^19.1.3",
		"vite": "^7.1.5",
		"vite-plugin-beautify": "^1.0.0",
		"vite-plugin-favicons-inject": "^2.2.0",
		"vite-plugin-imagemin": "^0.6.1",
		"vituum": "^1.2.0",
		"vue": "^3.5.21",
		"vue-i18n": "^11.1.12",
		"vue-i18n-extract": "^2.0.7",
		"vue-scrollto": "^2.20.0"
	},
	"dependencies": {
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.13",
		"aos": "^3.0.0-beta.6",
		"embla-carousel-vue": "^8.6.0",
		"photoswipe": "^5.4.4",
		"swiper": "^12.0.1",
		"tailwindcss": "^4.1.13"
	}
}
